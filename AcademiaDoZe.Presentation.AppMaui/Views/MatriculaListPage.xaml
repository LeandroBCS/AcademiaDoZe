<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.MatriculaListPage"
             x:Name="MatriculasPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:MatriculaListViewModel"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             Title="{Binding Title}">

    <!-- Recursos da Página -->
    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSourceConverter" />
        <converters:EnumDisplayConverter x:Key="EnumDisplay" />
        <converters:RestricoesFlagsDisplayConverter x:Key="RestricoesDisplay" />

        <!-- Template único para Phone, Tablet, Desktop, TV, Watch e Default -->
        <DataTemplate x:DataType="dto:MatriculaDto" x:Key="MatriculaItemTemplate">
            <SwipeView x:Name="RowSwipe">
                <SwipeView.RightItems>
                    <SwipeItems>
                        <SwipeItem BackgroundColor="DodgerBlue" Command="{Binding BindingContext.EditMatriculaCommand, Source={x:Reference MatriculasPage}}" CommandParameter="{Binding .}" Text="Editar"/>
                        <SwipeItem BackgroundColor="Red" Command="{Binding BindingContext.DeleteMatriculaCommand, Source={x:Reference MatriculasPage}}" CommandParameter="{Binding .}" Text="Excluir"/>
                    </SwipeItems>
                </SwipeView.RightItems>
                <Grid Margin="5" Padding="1">
                    <Border Margin="10" Style="{StaticResource CardBorder}">
                        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <!-- Foto do Aluno em moldura elegante -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="7" HeightRequest="110" Margin="0,0,10,0" Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" StrokeShape="RoundRectangle 12" StrokeThickness="1" VerticalOptions="Center" WidthRequest="110">
                                <Image Aspect="AspectFill" HeightRequest="110" Source="{Binding AlunoMatricula.Foto, Converter={StaticResource FotoToImageSourceConverter}}" WidthRequest="110"/>
                            </Border>

                            <!-- Nome do Aluno -->
                            <Label FontAttributes="Bold" FontSize="16" Grid.Column="0" Grid.Row="0" LineBreakMode="TailTruncation" Margin="0,0,0,2" Text="{Binding AlunoMatricula.Nome}"/>

                            <!-- CPF e Nascimento -->
                            <Label FontSize="12" Grid.Column="0" Grid.Row="1" Margin="0,0,0,4" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="CPF: "/>
                                        <Span Text="{Binding AlunoMatricula.Cpf}"/>
                                        <Span Text=" • Nasc: "/>
                                        <Span Text="{Binding AlunoMatricula.DataNascimento, StringFormat='{0:dd/MM/yyyy}'}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!-- Badge do Plano -->
                            <HorizontalStackLayout Grid.Column="0" Grid.Row="2" Margin="0,0,0,4" Spacing="8">
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" Padding="8,2" StrokeShape="RoundRectangle 4">
                                    <Label FontAttributes="Bold" FontSize="11" Text="{Binding Plano, Converter={StaticResource EnumDisplay}}" TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"/>
                                </Border>
                            </HorizontalStackLayout>

                            <!-- Vigência -->
                            <Label FontSize="12" Grid.Column="0" Grid.Row="3" Margin="0,0,0,3">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span FontAttributes="Bold" Text="Vigência: "/>
                                        <Span Text="{Binding DataInicio, StringFormat='{0:dd/MM/yyyy}'}"/>
                                        <Span Text=" até "/>
                                        <Span Text="{Binding DataFim, StringFormat='{0:dd/MM/yyyy}'}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!-- Objetivo -->
                            <Label FontSize="12" Grid.Column="0" Grid.Row="4" LineBreakMode="TailTruncation" Margin="0,0,0,3">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span FontAttributes="Bold" Text="Objetivo: "/>
                                        <Span Text="{Binding Objetivo}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!-- Restrições Médicas -->
                            <Label FontSize="12" Grid.Column="0" Grid.Row="5" LineBreakMode="TailTruncation" Margin="0,0,0,3">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span FontAttributes="Bold" Text="Restrições: "/>
                                        <Span Text="{Binding RestricoesMedicas, Converter={StaticResource RestricoesDisplay}}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!-- Observações -->
                            <Label FontSize="11" Grid.Column="0" Grid.Row="6" LineBreakMode="TailTruncation" Margin="0,0,0,2" Text="{Binding ObservacoesRestricoes, StringFormat='Obs: {0}'}" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>

                            <!-- Botão de Ações extras -->
                            <Button Clicked="OnMoreClicked" CommandParameter="{Binding .}" Grid.Column="1" Grid.Row="0" Margin="4,0" Style="{StaticResource ButtonSmall}" Text="">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe5d4;"/>
                                </Button.ImageSource>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </SwipeView>
        </DataTemplate>
    </ContentPage.Resources>

    <!-- Lista de Matrículas -->
    <Grid RowDefinitions="Auto,*">
        <!-- Search Bar -->
        <Border Grid.Row="0" Margin="15,10" Style="{StaticResource CardBorder}">
            <Grid ColumnDefinitions="Auto,10,*,10,Auto" VerticalOptions="Center">
                <Border Grid.Column="0" Style="{StaticResource InputBorder}" WidthRequest="116"><Picker HorizontalOptions="Start" ItemsSource="{Binding FilterTypes}" SelectedItem="{Binding SelectedFilterType}" Title="Filtro" VerticalOptions="Center"/></Border>
                <Border Grid.Column="2" Style="{StaticResource InputBorder}"><Entry ClearButtonVisibility="WhileEditing" Placeholder="Digite o valor..." ReturnCommand="{Binding SearchMatriculasCommand}" Text="{Binding SearchText}" VerticalOptions="Center"/></Border>
                <Button Command="{Binding SearchMatriculasCommand}" FontSize="14" Grid.Column="4" HeightRequest="40" Style="{StaticResource ButtonPrimary}" Text="" WidthRequest="80">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;" Color="{StaticResource PrimaryDarkText}"/>
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Border>

        <!-- Lista/Grade + FAB -->
        <Grid Grid.Row="1">
            <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
                <CollectionView ItemsSource="{Binding Matriculas}" Margin="10" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical">
                            <GridItemsLayout.Span>
                                <OnIdiom x:TypeArguments="x:Int32">
                                    <OnIdiom.Phone>1</OnIdiom.Phone>
                                    <OnIdiom.Default>1</OnIdiom.Default>
                                    <OnIdiom.Tablet>2</OnIdiom.Tablet>
                                    <OnIdiom.Desktop>3</OnIdiom.Desktop>
                                    <OnIdiom.TV>4</OnIdiom.TV>
                                </OnIdiom>
                            </GridItemsLayout.Span>
                        </GridItemsLayout>
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <StackLayout VerticalOptions="Center">
                            <Label HorizontalOptions="Center" Style="{StaticResource SubHeadline}" Text="Nenhuma matricula encontrada"/>
                            <Button Command="{Binding AddMatriculaCommand}" HeightRequest="50" Margin="0,20,0,0" Style="{StaticResource ButtonPrimary}" Text="Adicionar Primeira Matricula"/>
                        </StackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <StaticResource Key="MatriculaItemTemplate"/>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- FAB -->
            <Button Command="{Binding AddMatriculaCommand}" HeightRequest="56" HorizontalOptions="End" Margin="20" Style="{StaticResource ButtonPrimary}" Text="" VerticalOptions="End" WidthRequest="56">
                <Button.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=Black, Dark=Gray}" Offset="0,4" Opacity="0.3" Radius="8"/>
                </Button.Shadow>
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe145;"/>
                </Button.ImageSource>
            </Button>

            <!-- ActivityIndicator -->
            <ActivityIndicator HorizontalOptions="Center" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage>
