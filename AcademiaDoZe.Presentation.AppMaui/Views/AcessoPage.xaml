<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             xmlns:conv="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.AcessoPage"
             Title="Controle de Acesso">
    <ContentPage.Resources><conv:FotoToImageSourceConverter x:Key="Foto" /></ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,28" Spacing="16" MaximumWidthRequest="820" HorizontalOptions="Center">
            <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                <Label Text="Controle de Acesso / Catraca" Style="{StaticResource Headline}" HorizontalTextAlignment="Center" />
                <Label Text="Selecione a pessoa para registrar entrada ou saída." Style="{StaticResource StatLabel}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Tipo de acesso" Style="{StaticResource CardTitle}" HorizontalTextAlignment="Center" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Aluno" Command="{Binding SelecionarAlunoCommand}" Style="{StaticResource ButtonSecondary}">
                            <Button.ImageSource><FontImageSource FontFamily="MaterialIcons" Glyph="&#xe80c;" Color="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" /></Button.ImageSource>
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding TipoAlunoSelecionado}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="TextColor" Value="{StaticResource PrimaryDarkText}" />
                                    <Setter Property="BorderWidth" Value="0" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1" Text="Colaborador" Command="{Binding SelecionarColaboradorCommand}" Style="{StaticResource ButtonSecondary}">
                            <Button.ImageSource><FontImageSource FontFamily="MaterialIcons" Glyph="&#xea67;" Color="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" /></Button.ImageSource>
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding TipoAlunoSelecionado}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="TextColor" Value="{StaticResource PrimaryDarkText}" />
                                    <Setter Property="BorderWidth" Value="0" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                    <Border Style="{StaticResource ChipBorder}" HorizontalOptions="Center">
                        <Label Text="{Binding TextoModo}" Style="{StaticResource ChipLabel}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Localizar pessoa" Style="{StaticResource CardTitle}" HorizontalTextAlignment="Center" />
                    <Border Style="{StaticResource InputBorder}">
                        <SearchBar Placeholder="Digite nome ou CPF" Text="{Binding Busca}" SearchCommand="{Binding BuscarCommand}" VerticalOptions="Center" />
                    </Border>
                    <Label Text="{Binding ResultadoBusca}" IsVisible="{Binding BuscaSemResultados}" Style="{StaticResource StatLabel}" />
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Selecione a pessoa" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Picker Title="Toque para escolher" ItemsSource="{Binding Pessoas}" SelectedItem="{Binding PessoaSelecionada}" VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Identificação e liberação" Style="{StaticResource CardTitle}" HorizontalTextAlignment="Center" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalOptions="Center">
                        <Border Style="{StaticResource IconBadge}" WidthRequest="72" HeightRequest="72">
                            <Image Source="{Binding PessoaSelecionada.Foto, Converter={StaticResource Foto}}" WidthRequest="64" HeightRequest="64" Aspect="AspectFill" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding PessoaSelecionada.Nome, TargetNullValue='Nenhuma pessoa selecionada'}" Style="{StaticResource CardTitle}" />
                            <Label Text="{Binding PessoaSelecionada.Cpf, StringFormat='CPF: {0}'}" Style="{StaticResource StatLabel}" />
                            <Label Text="{Binding SituacaoPessoa}" Style="{StaticResource StatLabel}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Button Text="{Binding TextoAcao}" Command="{Binding RegistrarCommand}" IsEnabled="{Binding PodeRegistrar}" Style="{StaticResource ButtonPrimary}">
                        <Button.ImageSource><FontImageSource FontFamily="MaterialIcons" Glyph="&#xe897;" Color="{StaticResource PrimaryDarkText}" /></Button.ImageSource>
                    </Button>
                    <Border IsVisible="{Binding TemResultado}" Padding="14,12" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource DangerSoftLight}, Dark={StaticResource DangerSoftDark}}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding AcessoAutorizado}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessSoftLight}, Dark={StaticResource SuccessSoftDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="&#xe002;" FontFamily="MaterialIcons" FontSize="20" TextColor="{AppThemeBinding Light={StaticResource DangerInkLight}, Dark={StaticResource DangerInkDark}}" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding AcessoAutorizado}" Value="True">
                                        <Setter Property="Text" Value="&#xe876;" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SuccessInkLight}, Dark={StaticResource SuccessInkDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Grid.Column="1" Text="{Binding Mensagem}" TextColor="{AppThemeBinding Light={StaticResource DangerInkLight}, Dark={StaticResource DangerInkDark}}" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding AcessoAutorizado}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SuccessInkLight}, Dark={StaticResource SuccessInkDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label Text="Acessos registrados hoje" Style="{StaticResource CardTitle}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Atualizar" Command="{Binding AtualizarCommand}" Style="{StaticResource ButtonSecondary}" HeightRequest="40" Padding="14,0">
                    <Button.ImageSource><FontImageSource FontFamily="MaterialIcons" Glyph="&#xe5d5;" Color="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" /></Button.ImageSource>
                </Button>
            </Grid>
            <CollectionView ItemsSource="{Binding Acessos}" SelectionMode="None">
                <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="8" /></CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Border Style="{StaticResource CardBorder}" Margin="0,4">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="&#xe8b5;" Style="{StaticResource IconGlyph}" FontSize="32" />
                            <Label Text="Nenhum acesso registrado hoje." Style="{StaticResource StatLabel}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:AcessoDto">
                        <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,2">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Style="{StaticResource ChipBorder}" VerticalOptions="Start"><Label Text="&#xe8b5;" Style="{StaticResource IconGlyph}" FontSize="20" /></Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding Pessoa.Nome}" Style="{StaticResource CardTitle}" />
                                    <Label Text="{Binding Movimento, StringFormat='Movimento: {0}'}" Style="{StaticResource StatLabel}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding DataHora, StringFormat='{0:HH:mm:ss}'}" Style="{StaticResource ChipLabel}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
