<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.LogradouroListPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:LogradouroListViewModel"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             Title="{Binding Title}">
    <Grid RowDefinitions="Auto,*">

        <!-- Barra de busca: filtro + valor + botão -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="16,16,16,8" Padding="12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Border Grid.Column="0" Style="{StaticResource InputBorder}" WidthRequest="116">
                    <Picker Title="Filtro" ItemsSource="{Binding FilterTypes}" SelectedItem="{Binding SelectedFilterType}" VerticalOptions="Center"/>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource InputBorder}">
                    <Entry Text="{Binding SearchText}" Placeholder="Digite o valor..." ReturnCommand="{Binding SearchLogradourosCommand}" VerticalOptions="Center"/>
                </Border>
                <Button Grid.Column="2" Text="Buscar" Style="{StaticResource ButtonPrimary}" FontSize="14" HeightRequest="46" Padding="18,0" Command="{Binding SearchLogradourosCommand}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;"
                                         Color="{StaticResource PrimaryDarkText}"/>
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Border>

        <!-- Lista de Logradouros com FAB (Floating Action Button) -->
        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
                <CollectionView ItemsSource="{Binding Logradouros}" SelectionMode="None" Margin="16,0">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.Header>
                        <BoxView HeightRequest="6" Color="Transparent"/>
                    </CollectionView.Header>
                    <CollectionView.Footer>
                        <!-- Espaço para o botão flutuante não cobrir o último item -->
                        <BoxView HeightRequest="96" Color="Transparent"/>
                    </CollectionView.Footer>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="30">
                            <Label Text="📭" FontSize="52" HorizontalOptions="Center"/>
                            <Label Text="Nenhum logradouro encontrado" Style="{StaticResource CardTitle}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                            <Label Text="Tente outro filtro ou cadastre um novo endereço." Style="{StaticResource StatLabel}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                            <Button Text="Adicionar primeiro logradouro" Command="{Binding AddLogradouroCommand}" Style="{StaticResource ButtonPrimary}" Margin="0,14,0,0">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe145;"
                                                     Color="{StaticResource PrimaryDarkText}"/>
                                </Button.ImageSource>
                            </Button>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:LogradouroDto">
                            <Border Style="{StaticResource CardBorder}">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto" RowSpacing="6" ColumnSpacing="8">

                                    <!-- CEP + ações -->
                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ChipBorder}" HorizontalOptions="Start" VerticalOptions="Center">
                                        <Label Text="{Binding Cep}" Style="{StaticResource ChipLabel}"/>
                                    </Border>
                                    <Button Grid.Row="0" Grid.Column="1" Text="Editar" Style="{StaticResource ButtonSmall}" Clicked="OnEditButtonClicked">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe3c9;" Size="16"
                                                             Color="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"/>
                                        </Button.ImageSource>
                                    </Button>
                                    <Button Grid.Row="0" Grid.Column="2" Text="Excluir" Style="{StaticResource ButtonDanger}" Clicked="OnDeleteButtonClicked">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe872;" Size="16"
                                                             Color="{AppThemeBinding Light={StaticResource DangerInkLight}, Dark={StaticResource DangerInkDark}}"/>
                                        </Button.ImageSource>
                                    </Button>

                                    <!-- Rua -->
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding Nome}" Style="{StaticResource CardTitle}" Margin="0,8,0,0"/>

                                    <!-- Bairro • Cidade - UF • País -->
                                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource StatLabel}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Bairro}"/>
                                                <Span Text="  •  "/>
                                                <Span Text="{Binding Cidade}"/>
                                                <Span Text=" - "/>
                                                <Span Text="{Binding Estado}"/>
                                                <Span Text="  •  "/>
                                                <Span Text="{Binding Pais}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- Floating Action Button -->
            <Button Command="{Binding AddLogradouroCommand}" Style="{StaticResource ButtonPrimary}"
                    WidthRequest="58" HeightRequest="58" CornerRadius="29" Padding="0"
                    HorizontalOptions="End" VerticalOptions="End" Margin="24">
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe145;" Size="28" Color="{StaticResource PrimaryDarkText}"/>
                </Button.ImageSource>
                <Button.Shadow>
                    <Shadow Brush="#E0A526" Offset="0,6" Radius="14" Opacity="0.45"/>
                </Button.Shadow>
            </Button>
        </Grid>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center"/>
    </Grid>
</ContentPage>
