<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.DashboardListPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:DashboardListViewModel"
             Title="{Binding Title}">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,24,20,32" Spacing="24" MaximumWidthRequest="920" HorizontalOptions="Center">

                <!-- Hero: logo + nome da aplicação -->
                <Border Style="{StaticResource CardBorder}" Padding="20,28">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Image Source="academiadoze.png" HeightRequest="200" WidthRequest="200" Aspect="AspectFit" HorizontalOptions="Center"/>
                        <Label Text="PAINEL DE CONTROLE" FontSize="11" CharacterSpacing="3" TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource PrimaryDark}}" HorizontalOptions="Center" Margin="0,10,0,0"/>
                        <Label Text="Academia do Zé" Style="{StaticResource Headline}" HorizontalOptions="Center"/>
                        <Label Text="Sistema de Gerenciamento" Style="{StaticResource SubHeadline}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Indicadores -->
                <VerticalStackLayout Spacing="14">
                    <Label Text="Visão geral" Style="{StaticResource CardTitle}"/>

                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="14" ColumnSpacing="14">

                        <!-- Card Logradouros -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToLogradourosCommand}"/>
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                <Border Grid.Row="0" Style="{StaticResource IconBadge}">
                                    <Label Text="&#xe7f1;" Style="{StaticResource IconGlyph}"/>
                                </Border>
                                <Label Grid.Row="1" Text="{Binding TotalLogradouros}" Style="{StaticResource StatNumber}"/>
                                <Label Grid.Row="2" Text="Logradouros" Style="{StaticResource StatLabel}"/>
                            </Grid>
                        </Border>

                        <!-- Card Alunos -->
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToAlunosCommand}"/>
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                <Border Grid.Row="0" Style="{StaticResource IconBadge}">
                                    <Label Text="&#xe80c;" Style="{StaticResource IconGlyph}"/>
                                </Border>
                                <Label Grid.Row="1" Text="{Binding TotalAlunos}" Style="{StaticResource StatNumber}"/>
                                <Label Grid.Row="2" Text="Alunos" Style="{StaticResource StatLabel}"/>
                            </Grid>
                        </Border>

                        <!-- Card Colaboradores -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToColaboradoresCommand}"/>
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                <Border Grid.Row="0" Style="{StaticResource IconBadge}">
                                    <Label Text="&#xea67;" Style="{StaticResource IconGlyph}"/>
                                </Border>
                                <Label Grid.Row="1" Text="{Binding TotalColaboradores}" Style="{StaticResource StatNumber}"/>
                                <Label Grid.Row="2" Text="Colaboradores" Style="{StaticResource StatLabel}"/>
                            </Grid>
                        </Border>

                        <!-- Card Matrículas -->
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorder}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToMatriculasCommand}"/>
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                <Border Grid.Row="0" Style="{StaticResource IconBadge}">
                                    <Label Text="&#xefec;" Style="{StaticResource IconGlyph}"/>
                                </Border>
                                <Label Grid.Row="1" Text="{Binding TotalMatriculas}" Style="{StaticResource StatNumber}"/>
                                <Label Grid.Row="2" Text="Matrículas" Style="{StaticResource StatLabel}"/>
                            </Grid>
                        </Border>

                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Indicator -->
        <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center"/>
    </Grid>
</ContentPage>
