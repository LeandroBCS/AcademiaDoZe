<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- ===== Marca: dourado (combina com a logo preto e dourado) ===== -->
    <Color x:Key="Primary">#E0A526</Color>
    <Color x:Key="PrimaryDark">#F2BE45</Color>
    <!-- Texto sobre fundo dourado (botões primários) -->
    <Color x:Key="PrimaryDarkText">#1B1405</Color>
    <!-- Dourado suave (chips e ícones no tema claro) -->
    <Color x:Key="Secondary">#FBF1D6</Color>
    <Color x:Key="SecondaryDarkText">#F2BE45</Color>
    <!-- Âmbar escuro (texto de destaque no tema claro) -->
    <Color x:Key="Tertiary">#7A5200</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#1E1A14</Color>
    <Color x:Key="OffBlack">#121214</Color>

    <!-- ===== Neutros quentes ===== -->
    <Color x:Key="Gray100">#ECE8DF</Color>
    <Color x:Key="Gray200">#D9D3C5</Color>
    <Color x:Key="Gray300">#B9B2A2</Color>
    <Color x:Key="Gray400">#9A9385</Color>
    <Color x:Key="Gray500">#6F695D</Color>
    <Color x:Key="Gray600">#3A3835</Color>
    <Color x:Key="Gray900">#1A1A1D</Color>
    <Color x:Key="Gray950">#0E0E10</Color>

    <!-- ===== Superfícies (tema claro / escuro) ===== -->
    <Color x:Key="BackgroundLight">#F6F3EC</Color>
    <Color x:Key="BackgroundDark">#0E0E10</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1A1A1D</Color>
    <Color x:Key="SurfaceAltLight">#F0EBDF</Color>
    <Color x:Key="SurfaceAltDark">#26262A</Color>
    <Color x:Key="LineLight">#E6DFCF</Color>
    <Color x:Key="LineDark">#303034</Color>

    <!-- ===== Texto ===== -->
    <Color x:Key="InkLight">#1E1A14</Color>
    <Color x:Key="InkDark">#F5F2EB</Color>
    <Color x:Key="MutedLight">#6F685A</Color>
    <Color x:Key="MutedDark">#A8A194</Color>

    <!-- ===== Destaques ===== -->
    <Color x:Key="GoldSoftDark">#2E2610</Color>
    <Color x:Key="Danger">#E5484D</Color>
    <Color x:Key="DangerSoftLight">#FDECEC</Color>
    <Color x:Key="DangerSoftDark">#3B1E20</Color>
    <Color x:Key="DangerInkLight">#B42318</Color>
    <Color x:Key="DangerInkDark">#FF8F8A</Color>
    <Color x:Key="Success">#16A34A</Color>
    <Color x:Key="SuccessSoftLight">#DCFCE7</Color>
    <Color x:Key="SuccessSoftDark">#064E3B</Color>
    <Color x:Key="SuccessInkLight">#166534</Color>
    <Color x:Key="SuccessInkDark">#86EFAC</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
